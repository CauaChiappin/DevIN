# DevIN — exemplo completo de configuração (.env.example)
# Copie para um arquivo privado ".env" na raiz do projeto e substitua os valores vazios.
# NUNCA envie o .env real ao GitHub, ao frontend, a chats ou a arquivos públicos.
# Na Hostinger, proteja o .env contra acesso HTTP e confira permissões de leitura.
# O arquivo .env.example NÃO ativa recursos nem substitui migrations no MySQL.

# ============================================================
# 1) AMBIENTE E URL BASE
# ============================================================
# Ambiente local (XAMPP): development. Na Hostinger use production.
APP_ENV=development # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
APP_URL=http://localhost:8080/DevIN # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# Exemplo de produção (substitua as DUAS linhas acima no .env real):
# APP_ENV=production
# APP_URL=https://www.exposoftalcina.com/Trabalhos/3D/DevIN

# ============================================================
# 2) BANCO DE DADOS MYSQL
# ============================================================
# Estes valores são exemplos para desenvolvimento local; use os da Hostinger em produção.
DB_HOST=localhost # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DB_PORT=3306 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DB_NAME=devin # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DB_USER=root # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DB_PASS= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# 3) SESSÃO / AUTENTICAÇÃO JWT
# ============================================================
# OBRIGATÓRIO em produção: segredo exclusivo, longo e aleatório.
# Não use a senha de um ADM, uma chave de API ou o Token 2 neste campo.
# Em development, vazio permite apenas o fallback local do código.
DEVIN_JWT_SECRET= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# 4) E-MAILS SMTP
# ============================================================
# Gmail: smtp.gmail.com / porta 587 / tls.
# Microsoft 365: smtp.office365.com / porta 587 / tls.
DEVIN_SMTP_HOST= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DEVIN_SMTP_PORT=587 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DEVIN_SMTP_ENCRYPTION=tls # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DEVIN_SMTP_USERNAME= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# Utilize senha de aplicativo ou credencial SMTP apropriada, nunca senha comum da conta.
DEVIN_SMTP_PASSWORD= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# O remetente deve ser autorizado pelo provedor SMTP.
DEVIN_SMTP_FROM_EMAIL= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
DEVIN_SMTP_FROM_NAME="DevIN" # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# 5) GEMINI — GERAÇÃO E ANÁLISE DE CURRÍCULOS
# ============================================================
# Chave exclusiva do Gemini. Não compartilhe com o JARVIS Admin.
DEVIN_GEMINI_API_KEY= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# Modelo de exemplo; confirme disponibilidade e limite de uso no seu projeto.
DEVIN_GEMINI_MODEL=gemini-2.5-flash-lite # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# 6) JARVIS ADMIN — PROVEDOR E MODELO
# ============================================================
# Provedores implementados: openrouter, groq ou openai.
# O OpenRouter deste projeto aceita apenas modelos gratuitos (:free ou openrouter/free).
DEVIN_JARVIS_PROVIDER=openrouter # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# ID de modelo de exemplo; confirme se continua disponível antes de ativar.
DEVIN_JARVIS_MODEL=z-ai/glm-5.3-flash:free # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# API key PRINCIPAL (nunca inserir IDs de modelos aqui).
DEVIN_JARVIS_API_KEY= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# Segunda API key da OpenRouter (OPCIONAL).
# Utilizada só em falhas recuperáveis da chave principal.
# Duas chaves da mesma conta podem compartilhar a mesma cota.
DEVIN_JARVIS_BACKUP_API_KEY= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# Até 10 modelos gratuitos reserva, separados por vírgula, em ordem de preferência.
# Vazio = utilizar as reservas gratuitas padrão do código, terminando em openrouter/free.
DEVIN_JARVIS_FALLBACK_MODELS= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# Campo legado opcional: SOMENTE ID de modelo gratuito, NUNCA API key.
# Deixe vazio quando usar DEVIN_JARVIS_FALLBACK_MODELS ou a lista padrão.
DEVIN_JARVIS_FALLBACK_MODEL= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# Consultas controladas, histórico e envio supervisionado de mensagens.
# MANTER 0 até aplicar jarvis_admin_controlled_actions.sql e homologar com backup.
DEVIN_JARVIS_ACTIONS_ENABLED=0 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# Exclusões supervisionadas na aba Consultar (dependem das migrations
# jarvis_admin_controlled_actions.sql e 2026_11_16_004_jarvis_moderation.sql).
# Mantê-las desativadas até validar backup, auditoria e direitos dos ADMs.
DEVIN_JARVIS_DELETIONS_ENABLED=0 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# 7) LGPD — FASE 1 (PR #8, AINDA NÃO INTEGRADA À MAIN)
# ============================================================
# Estas opções ainda não têm efeito na main atual.
# Antes de ativar: revisar políticas, esquema real e migration LGPD em homologação.
# Segredo HMAC de 32+ caracteres aleatórios, DIFERENTE do DEVIN_JWT_SECRET.
DEVIN_LGPD_IP_HASH_KEY= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# Auditoria desligada até validação do banco e das rotas integradas.
DEVIN_LGPD_AUDIT_ENABLED=0 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
# Prazo operacional de logs de auditoria; não é prazo universal de retenção legal.
DEVIN_LGPD_AUDIT_RETENTION_DAYS=180 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# 8) TOKEN 2 DO ADM / JARVIS (PR #8, AINDA NÃO INTEGRADA À MAIN)
# ============================================================
# NÃO ativa Token 2 na main atual; o código e a migration pertencem à PR #8.
# Só colocar 1 APÓS:
# - integrar e revisar a PR #8 com a main atual;
# - aplicar 2026_11_09_002_admin_stepup.sql no banco correto (com backup);
# - cada um dos quatro ADMs cadastrar seu Token 2 em php/JarvisT.php;
# - testar login, JARVIS, operações críticas e recuperação/rollback.
# Token 1 = senha normal do login ADM.
# Token 2 = senha individual armazenada como hash na tabela administrador.
# NUNCA adicionar Token 1, Token 2 ou seus hashes a este .env.
DEVIN_ADMIN_STEPUP_ENABLED=0 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# Permissoes por nivel ADM; ativar so apos migration e atribuicao dos papeis.
DEVIN_ADMIN_RBAC_ENABLED=0 # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.

# ============================================================
# CENTRAL DE SUPORTE — ANEXOS PRIVADOS
# ============================================================
# Ideal: caminho ABSOLUTO fora de public_html, com permissões de escrita ao PHP.
# Exemplo fictício: /home/usuario/devin_support_private (criar previamente).
# Vazio = usar storage/support-attachments, bloqueada pelo Apache.
# O arquivo .htaccess protege somente em hospedagem com suporte a Apache.
# No php.ini: upload_max_filesize=20M, post_max_size=23M ou superior.
# O sistema valida tamanho e formato também pelo backend.
DEVIN_SUPPORT_STORAGE_DIR= # Explicação DevIN: Declara uma variável de configuração de exemplo; seu valor real deve permanecer fora do Git.
