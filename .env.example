# Configuração SMTP para envio de e-mails.
# Copie este arquivo para .env e preencha com os dados do seu provedor.

# Gmail: smtp.gmail.com | porta 587 | tls
# Outlook/Microsoft 365: smtp.office365.com | porta 587 | tls
DEVIN_SMTP_HOST=
DEVIN_SMTP_PORT=587
DEVIN_SMTP_ENCRYPTION=tls

# Usuário SMTP, normalmente o endereço de e-mail completo.
DEVIN_SMTP_USERNAME=

# Use a senha de aplicativo do provedor, não sua senha normal da conta.
DEVIN_SMTP_PASSWORD=

# O endereço remetente deve ser autorizado pelo provedor SMTP.
# Geralmente é o mesmo endereço usado em DEVIN_SMTP_USERNAME.
DEVIN_SMTP_FROM_EMAIL=
DEVIN_SMTP_FROM_NAME="DevIN"

# Aplicação local (XAMPP). Ajuste APP_URL se usar outro host, porta ou pasta.
APP_ENV=development
APP_URL=http://localhost:8080/DevIN

# Banco MySQL local do XAMPP. Preencha DB_PASS caso seu MySQL tenha senha.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devin
DB_USER=root
DB_PASS=

# Em desenvolvimento, se ficar vazio, a aplicação usa uma chave local automática.
# Em produção, defina uma chave aleatória forte e mantenha-a privada.
DEVIN_JWT_SECRET=

# JARVIS Admin experimental (branch feature/jarvis-admin).
# Use uma chave EXCLUSIVA para o JARVIS, diferente do Gemini dos currículos.
# Opções do provedor: openrouter, groq, openai. Configure um modelo realmente disponível.
# OpenRouter (exemplo de modelo gratuito com limites de uso, sujeito a mudanças):
DEVIN_JARVIS_PROVIDER=openrouter
DEVIN_JARVIS_MODEL=z-ai/glm-5.3-flash:free
DEVIN_JARVIS_API_KEY=

# Fallback opcional: somente OpenRouter, mesmo provedor e modelo terminado em :free.
# Em caso de erro temporário do principal, poderá usar a reserva (limitada pelo provedor).
DEVIN_JARVIS_FALLBACK_MODEL=
